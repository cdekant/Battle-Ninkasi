# Entwicklung hauptsächlich auf Debian: Textdateien immer mit LF,
# auch beim Auschecken unter Windows.
* text=auto eol=lf

# Windows-Skripte benötigen CRLF
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Binärdateien nie verändern
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.ogg binary
*.wav binary
*.mp3 binary
*.ttf binary
*.otf binary
*.pdf binary
*.zip binary
